# Mobile env (read at build time via expo-constants).
# Copy to .env and fill in. Re-prebuild after edits: `npx expo prebuild --clean`.

EXPO_PUBLIC_API_URL=http://localhost:8010
# iOS-specific client id from Google Cloud Console (OAuth client of type "iOS").
# Used for PKCE auth on device AND for cadence-api's token exchange — no secret.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

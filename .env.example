# Cadence — env file (copy to .env, fill in, then `docker compose up -d`).

# ── Postgres (docker compose only) ──────────────────────────────────────────
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# ── Service ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Crypto ──────────────────────────────────────────────────────────────────
# Fernet key for Google refresh-token encryption. Generate ONCE and keep secret.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# JWT signing secret for mobile-facing bearer tokens. Any high-entropy string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30

# ── Google OAuth ────────────────────────────────────────────────────────────
# Create ONE OAuth Client of type "iOS" in Google Cloud Console with bundle id
# `com.avyra.cadence`. Add `.../auth/gmail.readonly` to the consent screen scopes.
# iOS clients do NOT have a secret — leave GOOGLE_CLIENT_SECRET empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=cadence://oauth2redirect

# ── ai-engine (LLM gateway) ─────────────────────────────────────────────────
# When running cadence-api inside docker on Mac/Win and ai-engine on the host:
AI_ENGINE_URL=http://host.docker.internal:8000
# Must MATCH the same env var on the ai-engine container.
AI_ENGINE_SHARED_SECRET=

# ── Scheduler ───────────────────────────────────────────────────────────────
# User-set: poll Gmail every 2h, not continually.
GMAIL_POLL_INTERVAL_SECONDS=7200
OVERDUE_SWEEP_INTERVAL_SECONDS=3600
DIGEST_LOCAL_HOUR=7

# ── APNs ────────────────────────────────────────────────────────────────────
APNS_USE_SANDBOX=true
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=          # path to .p8 mounted into the container, OR set APNS_KEY_PEM directly
APNS_KEY_PEM=
APNS_TOPIC=com.avyra.cadence
